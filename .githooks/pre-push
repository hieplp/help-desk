#!/bin/sh
# Enable once: git config core.hooksPath .githooks
# Run hd-service tests only when pushed commits change hd-service.
zero="0000000000000000000000000000000000000000"
run=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	if [ "$remote_sha" = "$zero" ]; then
		run=1
	elif git diff --name-only "$remote_sha..$local_sha" -- hd-service 2>/dev/null | grep -q .; then
		run=1
	fi
done

[ "$run" -eq 1 ] || exit 0

echo "pre-push: running hd-service tests"
cd hd-service && ./gradlew test
